<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_amazon" model="ir.ui.view">
        <field name="name">sale.order.form.amazon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_amazon_order" type="object" class="oe_stat_button" icon="fa-shopping-bag"
                        invisible="not amazon_order_id" string="Amazon"/>
            </div>
        </field>
    </record>
    <record id="view_sales_order_filter_amazon" model="ir.ui.view">
        <field name="name">sale.order.search.amazon</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_sales_order_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="amazon" string="Amazon" domain="[('amazon_order_id', '!=', False)]"/>
            </xpath>
        </field>
    </record>
</odoo>
