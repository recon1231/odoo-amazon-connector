<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_amazon" model="ir.ui.view">
        <field name="name">product.template.form.amazon</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button name="action_open_amazon_listings" type="object" class="oe_stat_button" icon="shopping_bag"
                        invisible="not amazon_listing_count" groups="chi_amazon_connector.group_amazon_user">
                    <field name="amazon_listing_count" widget="statinfo" string="Amazon"/>
                </button>
            </div>
        </field>
    </record>
    <record id="product_normal_form_amazon" model="ir.ui.view">
        <field name="name">product.product.form.amazon</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="default_code" position="after">
                <field name="amazon_sku_alias" groups="chi_amazon_connector.group_amazon_user"/>
            </field>
        </field>
    </record>
</odoo>
