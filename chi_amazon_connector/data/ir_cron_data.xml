<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="cron_amazon_orders" model="ir.cron">
        <field name="name">Amazon Seller Hub: import orders &amp; push stock</field>
        <field name="model_id" ref="model_chi_amazon_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_orders()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_amazon_daily" model="ir.cron">
        <field name="name">Amazon Seller Hub: listings, FBA stock &amp; settlements</field>
        <field name="model_id" ref="model_chi_amazon_account"/>
        <field name="state">code</field>
        <field name="code">model._cron_sync_daily()</field>
        <field name="interval_number">6</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
